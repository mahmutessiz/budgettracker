# Uygulamanın dışarıdan erişilen adresi (Dokploy'da domain)
BETTER_AUTH_URL=http://localhost:5153
# Ters proxy zincirindeki IP/CIDR adresleri, virgülle ayrılmış (yalnızca proxy üzerinden erişimde)
# BETTER_AUTH_TRUSTED_PROXIES=172.18.0.2
# En az 32 karakter rastgele değer: openssl rand -base64 32
BETTER_AUTH_SECRET=

# İlk açılışta veritabanında hiç kullanıcı yoksa bu yönetici oluşturulur
ADMIN_EMAIL=admin@ev.local
ADMIN_PASSWORD=
ADMIN_NAME=Yönetici

# SQLite dosyası (Docker'da /app/data kalıcı volume)
DATABASE_PATH=./data/defter.db

# İsteğe bağlı: kur servisi (varsayılan https://api.frankfurter.dev/v1)
# FRANKFURTER_URL=
